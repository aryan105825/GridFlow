# @env: RPC_URL, CHAIN_ID, DEPLOYMENT_FILE, ISSUER_PRIVATE_KEY, TESTNET_RPC_URL, DEPLOYER_PRIVATE_KEY, ASSETS_FILE, DATA_DIR, RESULTS_DIR, TRAIN_START, TRAIN_END, ISSUE_START, ISSUE_END
# Copy to .env and edit. Python reads these only in gridproof/schemas.py:load_settings().
# Hardhat reads TESTNET_RPC_URL and DEPLOYER_PRIVATE_KEY only in hardhat.config.js.

# JSON-RPC endpoint the Python CLI talks to (local Hardhat node by default)
RPC_URL=http://127.0.0.1:8545

# Chain id of RPC_URL (31337 = local Hardhat, 11155111 = Sepolia)
CHAIN_ID=31337

# Deployment record written by scripts/deploy.js and read by the Python CLI
DEPLOYMENT_FILE=deployments/localhost.json

# Issuer key used to sign issueBatch / registerAsset. Leave BLANK to use the unlocked
# node account (local Hardhat). Required (0x-prefixed, 32 bytes) for Sepolia.
ISSUER_PRIVATE_KEY=

# Sepolia JSON-RPC URL (free public node or free provider key); used by `npm run deploy:testnet`
TESTNET_RPC_URL=

# Funded Sepolia key that deploys the contract; it becomes the contract owner and issuer
DEPLOYER_PRIVATE_KEY=

# Asset list (BM units, coordinates, capacity)
ASSETS_FILE=assets.yaml

# Where snapshots, models, batches and receipts are written
DATA_DIR=data

# Where evaluation JSON and report.html are written
RESULTS_DIR=results

# Training window: 11 months, already past final settlement
TRAIN_START=2024-04-01
TRAIN_END=2025-02-28

# Issue window: March 2025 (contains the 46-period DST day, 2025-03-30)
ISSUE_START=2025-03-01
ISSUE_END=2025-03-31
